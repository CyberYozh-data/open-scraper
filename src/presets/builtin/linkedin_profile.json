{
  "name": "linkedin_profile",
  "source": "linkedin",
  "description": "LinkedIn public profile. LinkedIn requires an authenticated session and walls most data behind login — pass session_id via request_override and expect self-heal/AI to carry most fields. Best-effort selectors target the public profile shell.",
  "kind": "builtin",
  "url_template": "https://www.linkedin.com/in/{username}",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "prem_res_rotating",
    "stealth": true,
    "wait_until": "domcontentloaded",
    "timeout_ms": 60000,
    "block_assets": true
  },
  "locales": {
    "global": { "domain": "com", "country": "US" }
  },
  "default_locale": "global",
  "parsing_instructions": {
    "type": "css",
    "fields": {
      "name": {
        "selector": "h1",
        "required": true,
        "post_process": [{ "op": "strip" }]
      },
      "headline": {
        "selector": ".text-body-medium.break-words, .top-card-layout__headline",
        "post_process": [{ "op": "strip" }]
      },
      "location": {
        "selector": ".text-body-small.inline.t-black--light, .top-card-layout__first-subline",
        "post_process": [{ "op": "strip" }]
      },
      "current_position": {
        "selector": "[aria-label='Current company'] span, .top-card-layout__entity-info",
        "post_process": [{ "op": "strip" }]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "name":             { "type": "string" },
      "headline":         { "type": "string" },
      "location":         { "type": "string" },
      "current_position": { "type": "string" }
    },
    "required": ["name"]
  },
  "self_heal": true,
  "prompt_schema": {
    "name": "person full name",
    "headline": "professional headline",
    "location": "city / region",
    "current_position": "current title and company"
  },
  "llm_extract_prompt": null,
  "version": 1,
  "updated_at": 1747267200.0
}
