  "parsing_instructions": {
    "type": "css",
    "fields": {
      "titles": {
        "selector": "li.serp-item .Organic",
        "attr": "html",
        "all": true,
        "required": true,
        "post_process": [
          {
            "op": "regex",
            "args": [
              "OrganicTitle-LinkText[^>]*>([\\s\\S]*?)</a>"
            ]
          },
          {
            "op": "strip_tags"
          },
          {
            "op": "strip"
          }
        ]
      },
      "links": {
        "selector": "li.serp-item .Organic",
        "attr": "html",
        "all": true,
        "post_process": [
          {
            "op": "regex",
            "args": [
              "<a[^>]*OrganicTitle-Link[^>]*href=\"(https?://[^\"]+)\""
            ]
          },
          {
            "op": "strip_tags"
          }
        ]
      },
      "snippets": {
        "selector": "li.serp-item .Organic",
        "attr": "html",
        "all": true,
        "post_process": [
          {
            "op": "regex",
            "args": [
              "OrganicText[^>]*>([\\s\\S]*)</div>"
            ]
          },
          {
            "op": "strip_tags"
          }
        ]
      },
      "result_blocks": {
        "selector": "li.serp-item .Organic",
        "attr": "html",
        "all": true
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "titles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "links": {
