{
  "name": "yandex_search",
  "source": "yandex",
  "description": "Yandex SERP results. Returns title/link/snippet/result_block arrays with one slot per result. Every field is anchored on the SAME organic block (li.serp-item .Organic) and digs its value out of that block's html, so a result missing its snippet yields null in its own slot instead of shifting every later row. The list item is NOT the row unit: a serp-item can carry no organic block (a widget such as 'Люди ищут') or two (a grouped result), measured live at 13 items/12 results (kz) and 13 items/14 results (am). ADS ARE INCLUDED: a paid block carries the same .Organic markup and is emitted as a row whose link is a yabs.yandex.ru/count/... tracker — filter on the link if you need organic-only. wait_until is 'load' because Yandex streams results in: at domcontentloaded one live run returned 2 of 18 results with no error. Links are unescaped after the html capture (lxml re-serialises '&' as '&amp;'); snippets read the whole OrganicText subtree, so a leading date span is concatenated onto the body rather than replacing it. Selectors verified against live ru/am/kz captures 2026-07-26: 18/18/18/18, 14/14/14/14, 12/12/12/12, zero nulls.",
  "kind": "builtin",
  "url_template": "https://yandex.ru/search/?text={query}&lr={lr}",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "prem_res_rotating",
    "prem_proxy_options": {
      "ip_filter": "quality-security"
    },
    "warmup": {
      "type": "homepage"
    },
    "browser_engine": "camoufox",
    "wait_until": "load",
    "wait_for_selector": "li.serp-item",
    "timeout_ms": 45000,
    "block_assets": false
  },
