{
  "name": "yandex_search",
  "source": "yandex",
  "description": "Yandex web search (organic results). Routes to yandex.com (international) or yandex.ru via `domain`; `country` matches proxy geo. Yandex is aggressively anti-bot (SmartCaptcha) — expect blocks without a clean residential/mobile proxy. Organic-result selectors are best-effort and may drift with Yandex's DOM.",
  "kind": "builtin",
  "url_template": "https://yandex.{domain}/search/?text={query}",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "res_rotating",
    "stealth": true,
    "wait_until": "domcontentloaded",
    "timeout_ms": 30000,
    "block_assets": true
  },
  "locales": {
    "us": { "domain": "com", "country": "US" },
    "uk": { "domain": "com", "country": "GB" },
    "de": { "domain": "com", "country": "DE" },
    "fr": { "domain": "com", "country": "FR" },
    "ru": { "domain": "ru",  "country": "RU" },
    "jp": { "domain": "com", "country": "JP" }
  },
  "default_locale": "us",
  "parsing_instructions": {
    "type": "css",
    "fields": {
      "titles": {
        "selector": "li.serp-item .OrganicTitle-LinkText, li.serp-item h2",
        "all": true,
        "required": true
      },
      "links": {
        "selector": "li.serp-item a.OrganicTitle-Link[href^='http'], li.serp-item a[href^='http']",
        "attr": "href",
        "all": true
      },
      "snippets": {
        "selector": "li.serp-item .OrganicText, li.serp-item .TextContainer",
        "all": true,
        "post_process": [{ "op": "strip" }]
      },
      "result_blocks": {
        "selector": "li.serp-item",
        "attr": "html",
        "all": true
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "titles":    { "type": "array", "items": { "type": "string" } },
      "links":     { "type": "array", "items": { "type": "string" } },
      "snippets":  { "type": "array", "items": { "type": "string" } }
    }
  },
  "self_heal": true,
  "prompt_schema": null,
  "llm_extract_prompt": null,
  "version": 1,
  "updated_at": 1747267200.0
}
