{
  "name": "yandex_search",
  "source": "yandex",
  "description": "Yandex web search (organic results) on yandex.ru. The result region is selected by Yandex's own `lr` region code (locale -> lr), not the proxy country: yandex.ru only serves un-blocked results to a Russian/CIS exit, so every locale routes through a Russian residential exit (country=RU) while `lr` localises the results (e.g. lr=84 -> US region). Yandex is aggressively anti-bot (SmartCaptcha) — a clean RU residential proxy is required. Camoufox engine; organic-result selectors are best-effort and may drift with Yandex's DOM.",
  "kind": "builtin",
  "url_template": "https://yandex.ru/search/?text={query}&lr={lr}",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "prem_res_rotating",
    "prem_proxy_options": { "ip_filter": "quality-security" },
    "warmup": { "type": "homepage" },
    "browser_engine": "camoufox",
    "wait_until": "domcontentloaded",
    "wait_for_selector": "li.serp-item",
    "timeout_ms": 45000,
    "block_assets": false
  },
  "locales": {
    "ru": { "domain": "ru", "country": "RU", "lr": "225" },
    "moscow": { "domain": "ru", "country": "RU", "lr": "213" },
    "spb": { "domain": "ru", "country": "RU", "lr": "2" },
    "by": { "domain": "ru", "country": "RU", "lr": "149" },
    "kz": { "domain": "ru", "country": "RU", "lr": "159" },
    "ua": { "domain": "ru", "country": "RU", "lr": "187" },
    "uz": { "domain": "ru", "country": "RU", "lr": "171" },
    "am": { "domain": "ru", "country": "RU", "lr": "168" },
    "az": { "domain": "ru", "country": "RU", "lr": "167" },
    "ge": { "domain": "ru", "country": "RU", "lr": "169" },
    "kg": { "domain": "ru", "country": "RU", "lr": "207" },
    "tj": { "domain": "ru", "country": "RU", "lr": "209" },
    "tm": { "domain": "ru", "country": "RU", "lr": "170" },
    "md": { "domain": "ru", "country": "RU", "lr": "208" },
    "tr": { "domain": "ru", "country": "RU", "lr": "983" },
    "us": { "domain": "ru", "country": "RU", "lr": "84" },
    "de": { "domain": "ru", "country": "RU", "lr": "96" },
    "fr": { "domain": "ru", "country": "RU", "lr": "124" },
    "gb": { "domain": "ru", "country": "RU", "lr": "102" },
    "pl": { "domain": "ru", "country": "RU", "lr": "120" },
    "ee": { "domain": "ru", "country": "RU", "lr": "179" },
    "lv": { "domain": "ru", "country": "RU", "lr": "206" },
    "lt": { "domain": "ru", "country": "RU", "lr": "117" }
  },
  "default_locale": "ru",
  "parsing_instructions": {
    "type": "css",
    "fields": {
      "titles": {
        "selector": "li.serp-item .OrganicTitle-LinkText, li.serp-item h2",
        "all": true,
        "required": true
      },
      "links": {
        "selector": "li.serp-item a.OrganicTitle-Link[href^='http'], li.serp-item a[href^='http']",
        "attr": "href",
        "all": true
      },
      "snippets": {
        "selector": "li.serp-item .OrganicText, li.serp-item .TextContainer",
        "all": true,
        "post_process": [{ "op": "strip" }]
      },
      "result_blocks": {
        "selector": "li.serp-item",
        "attr": "html",
        "all": true
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "titles":    { "type": "array", "items": { "type": "string" } },
      "links":     { "type": "array", "items": { "type": "string" } },
      "snippets":  { "type": "array", "items": { "type": "string" } }
    }
  },
  "self_heal": true,
  "prompt_schema": null,
  "llm_extract_prompt": null,
  "version": 2,
  "updated_at": 1784160000.0
}
