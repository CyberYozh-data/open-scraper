{
  "name": "amazon_product",
  "source": "amazon",
  "description": "Amazon product detail page. Pulls title, price, rating, availability, brand, feature bullets. Works across .com / .co.uk / .de / .fr / .co.jp.",
  "kind": "builtin",
  "url_template": "https://www.amazon.{domain}/dp/{asin}",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "prem_res_rotating",
    "prem_proxy_options": { "ip_filter": "quality-security" },
    "warmup": { "type": "homepage" },
    "stealth": true,
    "wait_until": "domcontentloaded",
    "timeout_ms": 60000,
    "block_assets": true
  },
  "locales": {
    "us": { "domain": "com",   "country": "US" },
    "uk": { "domain": "co.uk", "country": "GB" },
    "de": { "domain": "de",    "country": "DE" },
    "fr": { "domain": "fr",    "country": "FR" },
    "jp": { "domain": "co.jp", "country": "JP" }
  },
  "default_locale": "us",
  "parsing_instructions": {
    "type": "css",
    "fields": {
      "title": {
        "selector": "#productTitle",
        "required": true,
        "post_process": [{ "op": "strip" }]
      },
      "price": {
        "selector": ".a-price .a-offscreen",
        "post_process": [{ "op": "parse_price" }]
      },
      "price_raw": {
        "selector": ".a-price .a-offscreen"
      },
      "rating": {
        "selector": "#acrPopover .a-icon-alt",
        "post_process": [{ "op": "regex", "args": ["([\\d.]+)\\s+out of"] }, { "op": "parse_float" }]
      },
      "review_count": {
        "selector": "#acrCustomerReviewText",
        "post_process": [{ "op": "parse_int" }]
      },
      "availability": {
        "selector": "#availability span",
        "post_process": [{ "op": "strip" }]
      },
      "brand": {
        "selector": "#bylineInfo",
        "post_process": [
          { "op": "strip" },
          { "op": "regex", "args": ["(?:Visit the |Brand:\\s*)?(.+?)(?:\\s+Store)?$"] }
        ]
      },
      "bullets": {
        "selector": "#feature-bullets li span.a-list-item",
        "all": true,
        "post_process": [{ "op": "strip" }]
      },
      "asin": {
        "selector": "input#ASIN",
        "attr": "value"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "title": { "type": "string" },
      "price": { "type": "number" },
      "price_raw": { "type": "string" },
      "rating": { "type": "number" },
      "review_count": { "type": "integer" },
      "availability": { "type": "string" },
      "brand": { "type": "string" },
      "bullets": { "type": "array", "items": { "type": "string" } },
      "asin": { "type": "string" }
    },
    "required": ["title"]
  },
  "self_heal": true,
  "prompt_schema": null,
  "llm_extract_prompt": null,
  "version": 1,
  "updated_at": 1747267200.0
}
