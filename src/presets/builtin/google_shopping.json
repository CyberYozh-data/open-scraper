{
  "name": "google_shopping",
  "source": "google",
  "description": "Google Shopping tab (udm=28). Google rewrites this surface frequently — selectors are best-effort and self_heal is on so the LLM regenerates them when they drift. Materializer lowercases country for gl= and derives lang for hl=.",
  "kind": "builtin",
  "url_template": "https://www.google.{domain}/search?q={query}&udm=28&gl={country}&hl={lang}",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "res_rotating",
    "stealth": true,
    "wait_until": "domcontentloaded",
    "timeout_ms": 45000,
    "block_assets": true
  },
  "locales": {
    "us": { "domain": "com",   "country": "US" },
    "uk": { "domain": "co.uk", "country": "GB" },
    "de": { "domain": "de",    "country": "DE" }
  },
  "default_locale": "us",
  "parsing_instructions": {
    "type": "css",
    "fields": {
      "titles": {
        "selector": ".sh-dgr__content h3, .sh-dgr__grid-result h3",
        "all": true,
        "required": true,
        "post_process": [{ "op": "strip" }]
      },
      "prices": {
        "selector": ".sh-dgr__content .a8Pemb, .sh-dgr__grid-result span[aria-hidden='true']",
        "all": true
      },
      "merchants": {
        "selector": ".sh-dgr__content .aULzUe, .sh-dgr__grid-result .aULzUe",
        "all": true
      },
      "urls": {
        "selector": ".sh-dgr__content a, .sh-dgr__grid-result a",
        "attr": "href",
        "all": true
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "titles":    { "type": "array", "items": { "type": "string" } },
      "prices":    { "type": "array", "items": { "type": "string" } },
      "merchants": { "type": "array", "items": { "type": "string" } },
      "urls":      { "type": "array", "items": { "type": "string" } }
    }
  },
  "self_heal": true,
  "prompt_schema": {
    "titles": "product title text",
    "prices": "displayed price string",
    "merchants": "seller / store name",
    "urls": "product or merchant link"
  },
  "llm_extract_prompt": null,
  "version": 1,
  "updated_at": 1747267200.0
}
