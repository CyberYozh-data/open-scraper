{
  "name": "google_shopping",
  "source": "google",
  "description": "Google Shopping tab (udm=28). Google's obfuscated class names change frequently (self_heal regenerates on drift). titles/prices are read per-card (div.PhALMc container) so they stay index-aligned; merchants is best-effort and may desync if a card omits the store; organic cards expose no per-card product URL (JS side-panel) so urls is empty. Materializer lowercases country for gl= and derives lang for hl=.",
  "kind": "builtin",
  "url_template": "https://www.google.{domain}/search?q={query}&udm=28&gl={country}&hl={lang}",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "prem_res_rotating",
    "warmup": { "type": "homepage" },
    "stealth": false,
    "wait_until": "domcontentloaded",
    "timeout_ms": 45000,
    "block_assets": true
  },
  "locales": {
    "us": { "domain": "com",   "country": "US" },
    "uk": { "domain": "co.uk", "country": "GB" },
    "de": { "domain": "de",    "country": "DE" }
  },
  "default_locale": "us",
  "parsing_instructions": {
    "type": "css",
    "fields": {
      "titles": {
        "selector": "div.PhALMc.bVO81.lLi9V",
        "attr": "html",
        "all": true,
        "required": true,
        "post_process": [
          {
            "op": "regex",
            "args": [
              "gkQHve[^>]*>([^<]+)"
            ]
          },
          {
            "op": "strip"
          }
        ]
      },
      "prices": {
        "selector": "div.PhALMc.bVO81.lLi9V",
        "attr": "html",
        "all": true,
        "post_process": [
          {
            "op": "regex",
            "args": [
              "lmQWe[^>]*>([^<]+)"
            ]
          },
          {
            "op": "strip"
          }
        ]
      },
      "merchants": {
        "selector": "div.PhALMc.bVO81.lLi9V span.Z9qvte",
        "attr": "text",
        "all": true
      },
      "urls": {
        "selector": "div.PhALMc.bVO81.lLi9V a[href^='http']",
        "attr": "href",
        "all": true
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "titles":    { "type": "array", "items": { "type": "string" } },
      "prices":    { "type": "array", "items": { "type": "string" } },
      "merchants": { "type": "array", "items": { "type": "string" } },
      "urls":      { "type": "array", "items": { "type": "string" } }
    }
  },
  "self_heal": true,
  "prompt_schema": {
    "titles": "product title text",
    "prices": "displayed price string",
    "merchants": "seller / store name",
    "urls": "product or merchant link"
  },
  "llm_extract_prompt": null,
  "version": 1,
  "updated_at": 1747267200.0
}
