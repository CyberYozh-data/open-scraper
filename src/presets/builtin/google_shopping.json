{
  "name": "google_shopping",
  "source": "google",
  "description": "Google Shopping tab (udm=28). Google's obfuscated class names change frequently (self_heal regenerates on drift). titles/prices are read per-card (div.PhALMc container) so they stay index-aligned; merchants is best-effort and may desync if a card omits the store; organic cards expose no per-card product URL (JS side-panel) so no url column is offered. Materializer lowercases country for gl= and derives lang for hl=. Product urls are NOT extractable: Google Shopping renders the cards with no <a href> at all (0 anchors across 55 live cards, 2026-07-26) and navigates via JS, so the field was removed rather than shipped permanently empty — an empty all=true field is not harmless, it trips row_alignment_mismatch on every successful run.",
  "kind": "builtin",
  "url_template": "https://www.google.{domain}/search?q={query}&udm=28&gl={country}&hl={lang}",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "prem_res_rotating",
    "warmup": {
      "type": "homepage"
    },
    "stealth": false,
    "wait_until": "domcontentloaded",
    "timeout_ms": 45000,
    "block_assets": true
  },
  "locales": {
    "us": {
      "domain": "com",
      "country": "US",
      "proxy_country": "GB"
    },
    "uk": {
      "domain": "co.uk",
      "country": "GB"
    },
    "de": {
      "domain": "de",
      "country": "DE"
    }
  },
  "default_locale": "us",
  "parsing_instructions": {
    "type": "css",
    "fields": {
      "titles": {
        "selector": "div.PhALMc.bVO81.lLi9V",
        "attr": "html",
        "all": true,
        "required": true,
        "post_process": [
          {
            "op": "regex",
            "args": [
              "gkQHve[^>]*>([^<]+)"
            ]
          },
          {
            "op": "strip"
          }
        ]
      },
      "prices": {
        "selector": "div.PhALMc.bVO81.lLi9V",
        "attr": "html",
        "all": true,
        "post_process": [
          {
            "op": "regex",
            "args": [
              "lmQWe[^>]*>([^<]+)"
            ]
          },
          {
            "op": "strip"
          }
        ]
      },
      "merchants": {
        "selector": "div.PhALMc.bVO81.lLi9V span.Z9qvte",
        "attr": "text",
        "all": true
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "titles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "prices": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "merchants": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "self_heal": true,
  "prompt_schema": {
    "titles": "product title text",
    "prices": "displayed price string",
    "merchants": "seller / store name"
  },
  "llm_extract_prompt": null,
  "version": 3,
  "updated_at": 1785024000.0
}
