{
  "name": "bing_search",
  "source": "bing",
  "description": "Bing web search (organic results). Fixed bing.com host; country routed via cc= and language via setlang= (derived from the locale). Materializer lowercases `country` for cc= and derives a language code for setlang= from the locale. Every organic href is a click-tracking wrapper — bing.com/ck/a?...&u=a1<base64url> — so `links` read straight from href pointed at bing.com on EVERY row: a field 100% populated and 100% useless, which no fill-rate check can see. The destination is recovered by pulling the `u=a1` capture and base64-decoding it. An href that is not a wrapper yields null rather than a mangled value.",
  "kind": "builtin",
  "url_template": "https://www.bing.com/search?q={query}&cc={country}&setlang={lang}",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "prem_res_rotating",
    "stealth": false,
    "wait_until": "domcontentloaded",
    "timeout_ms": 30000,
    "block_assets": true
  },
  "locales": {
    "us": {
      "domain": "com",
      "country": "US"
    },
    "uk": {
      "domain": "com",
      "country": "GB"
    },
    "de": {
      "domain": "com",
      "country": "DE"
    },
    "fr": {
      "domain": "com",
      "country": "FR"
    },
    "ru": {
      "domain": "com",
      "country": "RU"
    },
    "jp": {
      "domain": "com",
      "country": "JP"
    }
  },
  "default_locale": "us",
  "parsing_instructions": {
    "type": "css",
    "fields": {
      "titles": {
        "selector": "li.b_algo h2",
        "all": true,
        "required": true
      },
      "links": {
        "selector": "li.b_algo h2 a[href^='http']",
        "attr": "href",
        "all": true,
        "post_process": [
          {
            "op": "regex",
            "args": [
              "[?&]u=a1([A-Za-z0-9_-]+)"
            ]
          },
          {
            "op": "base64_decode"
          }
        ]
      },
      "snippets": {
        "selector": "li.b_algo .b_caption p, li.b_algo p.b_lineclamp2",
        "all": true,
        "post_process": [
          {
            "op": "strip"
          }
        ]
      },
      "result_blocks": {
        "selector": "li.b_algo",
        "attr": "html",
        "all": true
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "titles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "links": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "snippets": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "self_heal": true,
  "prompt_schema": null,
  "llm_extract_prompt": null,
  "version": 2,
  "updated_at": 1786320000.0
}
