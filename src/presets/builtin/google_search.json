{
  "name": "google_search",
  "source": "google",
  "description": "Google web search (organic results). Routes to country-specific domain (google.de, google.co.uk, ...) and matches proxy geo. Materializer must lowercase `country` for gl= and derive a language code for hl= from the locale.",
  "kind": "builtin",
  "url_template": "https://www.google.{domain}/search?q={query}&gl={country}&hl={lang}",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "prem_res_rotating",
    "warmup": { "type": "homepage" },
    "stealth": false,
    "wait_until": "domcontentloaded",
    "timeout_ms": 30000,
    "block_assets": true
  },
  "locales": {
    "us": { "domain": "com",   "country": "US" },
    "uk": { "domain": "co.uk", "country": "GB" },
    "de": { "domain": "de",    "country": "DE" },
    "fr": { "domain": "fr",    "country": "FR" },
    "ru": { "domain": "ru",    "country": "RU" },
    "jp": { "domain": "co.jp", "country": "JP" }
  },
  "default_locale": "us",
  "parsing_instructions": {
    "type": "css",
    "fields": {
      "titles": {
        "selector": "div.g h3, div[data-hveid] h3",
        "all": true,
        "required": true
      },
      "links": {
        "selector": "div.g a[href^='http'], div[data-hveid] a[href^='http']",
        "attr": "href",
        "all": true
      },
      "snippets": {
        "selector": "div[data-sncf='1'], .VwiC3b",
        "all": true,
        "post_process": [{ "op": "strip" }]
      },
      "result_blocks": {
        "selector": "div[data-hveid]",
        "attr": "html",
        "all": true
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "titles":    { "type": "array", "items": { "type": "string" } },
      "links":     { "type": "array", "items": { "type": "string" } },
      "snippets":  { "type": "array", "items": { "type": "string" } }
    }
  },
  "self_heal": true,
  "prompt_schema": null,
  "llm_extract_prompt": null,
  "version": 1,
  "updated_at": 1747267200.0
}
