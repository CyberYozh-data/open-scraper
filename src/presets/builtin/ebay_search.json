{
  "name": "ebay_search",
  "source": "ebay",
  "description": "eBay search results (sorted newest), su-card layout. Returns title/price/url arrays for item listings in the results river. Titles and urls share the [href*='/itm/'] selector, so they stay structurally co-indexed and also exclude eBay's 'Shop on eBay' dummy and 'related searches' suggestion cards (which link to /sch/). Prices use a separate selector, so price-to-title alignment is best-effort: a listing with no price node (e.g. auction-only) shifts the price array. Per-listing condition/shipping aren't column-alignable here; use LLM extraction for reliable per-row data. Selectors verified against live markup 2026-07.",
  "kind": "builtin",
  "url_template": "https://www.ebay.{domain}/sch/i.html?_nkw={query}&_sop=12",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "prem_res_rotating",
    "prem_proxy_options": { "ip_filter": "quality-security" },
    "warmup": { "type": "homepage" },
    "stealth": true,
    "wait_until": "domcontentloaded",
    "timeout_ms": 60000,
    "block_assets": false
  },
  "locales": {
    "us": { "domain": "com",   "country": "US" },
    "uk": { "domain": "co.uk", "country": "GB" },
    "de": { "domain": "de",    "country": "DE" }
  },
  "default_locale": "us",
  "parsing_instructions": {
    "type": "css",
    "fields": {
      "titles": {
        "selector": ".srp-river-results .su-item-card__title[href*='/itm/']",
        "all": true,
        "required": true,
        "post_process": [{ "op": "strip" }]
      },
      "prices": {
        "selector": ".srp-river-results .su-item-card__price",
        "all": true,
        "post_process": [{ "op": "strip" }]
      },
      "urls": {
        "selector": ".srp-river-results .su-item-card__title[href*='/itm/']",
        "attr": "href",
        "all": true
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "titles": { "type": "array", "items": { "type": "string" } },
      "prices": { "type": "array", "items": { "type": "string" } },
      "urls":   { "type": "array", "items": { "type": "string" } }
    }
  },
  "self_heal": true,
  "prompt_schema": null,
  "llm_extract_prompt": null,
  "version": 2,
  "updated_at": 1783814400.0
}
