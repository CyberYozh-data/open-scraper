{
  "name": "amazon_search",
  "source": "amazon",
  "description": "Amazon search results page. Returns one flat array per field across result cards; consumers zip them by index. ROW-ALIGNMENT INVARIANT: each field must match exactly one node per card, so every field anchors to a per-card container Amazon renders on EVERY card (title-recipe / price-recipe / asin-faceout-container) and digs the value out of that container's html by regex. A container that is present but empty yields null in the correct slot; a selector that matches NOTHING does not yield null — it shrinks the array and silently misaligns every row after it. So never point a field at an element that only exists when the value does (e.g. .a-price .a-offscreen directly): anchor to the always-present container instead. Localizes by domain (.com/.co.uk/.de). block_assets off so lazy product images load.",
  "kind": "builtin",
  "url_template": "https://www.amazon.{domain}/s?k={query}",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "prem_res_rotating",
    "stealth": true,
    "wait_until": "domcontentloaded",
    "timeout_ms": 60000,
    "block_assets": false
  },
  "locales": {
    "us": { "domain": "com",   "country": "US" },
    "uk": { "domain": "co.uk", "country": "GB" },
    "de": { "domain": "de",    "country": "DE" }
  },
  "default_locale": "us",
  "parsing_instructions": {
    "type": "css",
    "fields": {
      "titles": {
        "selector": "div[data-component-type='s-search-result'] [data-cy='title-recipe'] h2",
        "all": true,
        "required": true,
        "post_process": [{ "op": "strip" }]
      },
      "urls": {
        "selector": "div[data-component-type='s-search-result'] [data-cy='title-recipe'] > a[href]",
        "attr": "href",
        "all": true
      },
      "prices": {
        "selector": "div[data-component-type='s-search-result'] [data-cy='price-recipe']",
        "attr": "html",
        "all": true,
        "post_process": [
          { "op": "regex", "args": ["a-offscreen[^>]*>[^<]*?(\\d[\\d.,]*\\d|\\d)"] },
          { "op": "parse_price" }
        ]
      },
      "ratings": {
        "selector": "div[data-component-type='s-search-result'] [data-cy='asin-faceout-container']",
        "attr": "html",
        "all": true,
        "post_process": [
          { "op": "regex", "args": ["a-icon-alt[^>]*>(?:\\s|<[a-zA-Z][^>]*>)*(\\d[.,]\\d)"] },
          { "op": "replace", "args": [",", "."] },
          { "op": "parse_float" }
        ]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "titles": { "type": "array", "items": { "type": "string" } },
      "urls":   { "type": "array", "items": { "type": "string" } },
      "prices": { "type": "array", "items": { "type": "number" } },
      "ratings": { "type": "array", "items": { "type": "number" } }
    }
  },
  "self_heal": true,
  "prompt_schema": null,
  "llm_extract_prompt": null,
  "version": 2,
  "updated_at": 1784246400.0
}
