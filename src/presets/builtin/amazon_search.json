{
  "name": "amazon_search",
  "source": "amazon",
  "description": "Amazon search results page. Returns one array per field across result cards. Localizes by domain (.com/.co.uk/.de). block_assets off so lazy product images load.",
  "kind": "builtin",
  "url_template": "https://www.amazon.{domain}/s?k={query}",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "res_rotating",
    "stealth": true,
    "wait_until": "domcontentloaded",
    "timeout_ms": 60000,
    "block_assets": false
  },
  "locales": {
    "us": { "domain": "com",   "country": "US" },
    "uk": { "domain": "co.uk", "country": "GB" },
    "de": { "domain": "de",    "country": "DE" }
  },
  "default_locale": "us",
  "parsing_instructions": {
    "type": "css",
    "fields": {
      "titles": {
        "selector": "div[data-component-type='s-search-result'] h2 span",
        "all": true,
        "required": true,
        "post_process": [{ "op": "strip" }]
      },
      "urls": {
        "selector": "div[data-component-type='s-search-result'] a.a-link-normal.s-line-clamp-2",
        "attr": "href",
        "all": true
      },
      "prices": {
        "selector": "div[data-component-type='s-search-result'] .a-price .a-offscreen",
        "all": true,
        "post_process": [{ "op": "parse_price" }]
      },
      "ratings": {
        "selector": "div[data-component-type='s-search-result'] .a-icon-alt",
        "all": true,
        "post_process": [{ "op": "regex", "args": ["([\\d.]+)"] }, { "op": "parse_float" }]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "titles": { "type": "array", "items": { "type": "string" } },
      "urls":   { "type": "array", "items": { "type": "string" } },
      "prices": { "type": "array", "items": { "type": "number" } },
      "ratings": { "type": "array", "items": { "type": "number" } }
    }
  },
  "self_heal": true,
  "prompt_schema": null,
  "llm_extract_prompt": null,
  "version": 1,
  "updated_at": 1747267200.0
}
