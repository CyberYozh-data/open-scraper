{
  "name": "walmart_product",
  "source": "walmart",
  "description": "Walmart US product page. Walmart's markup is React-rendered and rotates class names — selectors target stable data-testid/itemprop hooks, self_heal on for drift. price reads the last currency-marked number in the microdata node: the live value is rendered as 'Now $199.00', and any savings/was label precedes the current price. rating is anchored on its parentheses because the node also carries the review count ('(4.4)|44.4K ratings'), where the same digits appear twice; a whole-number rating would return null. KNOWN GAP: availability came back null on 1 of 2 live captures 2026-07-26 and is not addressed here.",
  "kind": "builtin",
  "url_template": "https://www.walmart.com/ip/{product_id}",
  "request_defaults": {
    "device": "desktop",
    "proxy_type": "prem_res_rotating",
    "browser_engine": "camoufox",
    "stealth": false,
    "wait_until": "domcontentloaded",
    "timeout_ms": 60000,
    "block_assets": true
  },
  "locales": {
    "us": {
      "domain": "com",
      "country": "US"
    }
  },
  "default_locale": "us",
  "parsing_instructions": {
    "type": "css",
    "fields": {
      "title": {
        "selector": "h1[itemprop='name'], h1#main-title",
        "required": true,
        "post_process": [
          {
            "op": "strip"
          }
        ]
      },
      "price": {
        "selector": "span[itemprop='price']",
        "post_process": [
          {
            "op": "regex",
            "args": [
              ".*\\$\\s*([\\d,]+(?:\\.\\d{2})?)"
            ]
          },
          {
            "op": "parse_price"
          }
        ]
      },
      "rating": {
        "selector": "[data-testid='reviews-and-ratings']",
        "post_process": [
          {
            "op": "regex",
            "args": [
              "\\((\\d[.,]\\d)\\)"
            ]
          },
          {
            "op": "replace",
            "args": [
              ",",
              "."
            ]
          },
          {
            "op": "parse_float"
          }
        ]
      },
      "availability": {
        "selector": "[data-testid='fulfillment-add-to-cart'] button, [data-automation-id='atc']",
        "post_process": [
          {
            "op": "strip"
          }
        ]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "price": {
        "type": "number"
      },
      "rating": {
        "type": "number"
      },
      "availability": {
        "type": "string"
      }
    },
    "required": [
      "title"
    ]
  },
  "self_heal": true,
  "prompt_schema": {
    "title": "product name",
    "price": "current price as a number",
    "rating": "average star rating",
    "availability": "in-stock / add-to-cart state"
  },
  "llm_extract_prompt": null,
  "version": 2,
  "updated_at": 1785024000.0
}
